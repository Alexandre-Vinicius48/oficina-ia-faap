# =============================================================================
# VARIAVEIS DE AMBIENTE
#
# 1. Copie este arquivo com o nome .env.local  (comando: cp .env.example .env.local)
# 2. Preencha os tres valores abaixo com os dados do SEU projeto no Supabase.
# 3. NUNCA envie o arquivo .env.local para o GitHub (ele ja esta no .gitignore).
#
# Onde encontrar cada valor: Supabase -> seu projeto -> Settings -> API Keys
# =============================================================================

# Endereco do projeto ("Project URL"). Pode aparecer no navegador, e publico.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave publica ("anon public"). Tambem pode aparecer no navegador.
# Sozinha ela nao le nem grava nada: a seguranca esta nas politicas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Chave SECRETA ("service_role"). NUNCA compartilhe e NUNCA coloque o prefixo
# NEXT_PUBLIC_ nela. Ela so e usada dentro do servidor.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role
